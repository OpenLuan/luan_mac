[submodule "libevent"]
	path = lua-apple/libevent
	url = https://github.com/libevent/libevent.git
[submodule "lua53"]
	path = lua-apple/lua53
	url = https://github.com/lua/lua.git
[submodule "lua-apple/third_party/brotli"]
	path = lua-apple/third_party/brotli
	url = https://github.com/google/brotli.git
[submodule "lua-apple/third_party/lua-openssl"]
	path = lua-apple/third_party/lua-openssl
