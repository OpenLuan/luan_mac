[submodule "lua-apple/third_party/openssl"]
	path = lua-apple/third_party/openssl
	url = https://github.com/openssl/openssl.git
[submodule "luan"]
	path = luan
	url = https://github.com/OpenLuan/luan.git
	branch = main
[submodule "webase"]
